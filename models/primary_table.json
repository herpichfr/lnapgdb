    },
    {
        "colname": "OBID",
        "mandatory": "n",
        "datatype": "Integer",
        "description": "Observation Block ID run number"
    },
    {
        "colname": "PRODCATG",
        "mandatory": "n",
        "datatype": "String",
        "description": "Data product category"
    },
    {
        "colname": "CHECKSUM",
        "mandatory": "y",
        "nullable": false,
        "datatype": "String",
        "description": "HDU checksum"
    },
    {
        "colname": "DATASUM",
        "mandatory": "y",
        "nullable": false,
        "datatype": "String",
        "description": "Data unit checksum"
    },
    {
        "colname": "COMMENT",
        "mandatory": "n",
