[
    {
        "colname": "SIMPLE",
        "mandatory": "y",
        "nullable": false,
        "default_value": "T",
        "datatype": "Boolean",
        "description": "Standard FITS (NOST-100-2.0)"
    },
    {
        "colname": "BSCALE",
        "mandatory": "y",
        "datatype": "Integer",
        "description": "Linear factor in scaling equation"
    },
    {
        "colname": "BZERO",
        "mandatory": "y",
        "datatype": "Float",
        "description": "value = fits-value*BSCALE+BZERO"
    },
    {
        "colname": "BUNIT",
        "mandatory": "n",
        "datatype": "String",
        "description": "Physical unit of array values"
    },
    {
        "colname": "BITPIX",
        "mandatory": "y",
        "datatype": "Integer",
        "description": "# bits storing pix values"
    },
    {
        "colname": "NAXIS",
        "mandatory": "y",
        "nullable": false,
        "datatype": "Integer",
        "description": "# of axes in frame"
    },
    {
        "colname": "NAXIS1",
        "mandatory": "y",
        "nullable": false,
        "datatype": "Integer",
        "description": "# of pixels/row"
    },
    {
        "colname": "NAXIS2",
        "mandatory": "y",
        "nullable": false,
        "datatype": "Integer",
        "description": "# of rows (also # of scan lines)"
    },
    {
        "colname": "EXTEND",
        "mandatory": "y",
        "default_value": "T",
        "datatype": "Boolean",
        "description": "Extensions may be present"
    },
    {
        "colname": "PROPID",
        "mandatory": "y",
        "nullable": false,
        "default_value": "UNKNOWN",
        "datatype": "String",
        "description": "The identification code assigned to each observing run by the Science Committee"
    },
    {
        "colname": "PROPOSAL",
        "mandatory": "n",
        "datatype": "String",
        "description": "Through where the proposal was received"
    },
    {
        "colname": "OBSERVER",
        "mandatory": "n",
        "datatype": "String",
        "description": "Name of the observer"
    },
    {
        "colname": "OBJECT",
        "mandatory": "n",
        "datatype": "String",
        "description": "Target as given by the user"
    },
    {
        "colname": "ORIGIN",
        "mandatory": "n",
        "default_value": "LNA",
        "datatype": "String",
        "description": "Who delivers the data"
    },
    {
        "colname": "TELESCOP",
        "mandatory": "n",
        "datatype": "String",
        "description": "Telescope name"
    },
    {
        "colname": "SITEID",
        "mandatory": "n",
        "datatype": "String",
        "description": "Observatory/Site"
    },
    {
        "colname": "OBSLONG",
        "mandatory": "n",
        "datatype": "Float",
        "allowed_values": "range:-180,180",
        "description": "Observatory East Longitude (DEG, -180 to 180)"
    },
    {
        "colname": "OBSLAT",
        "mandatory": "n",
        "datatype": "Float",
        "allowed_values": "range:-90,90",
        "description": "Observatory North Latitude (DEG, -90 to 90)"
    },
    {
        "colname": "OBSALT",
        "mandatory": "n",
        "datatype": "float",
        "allowed_values": "range:0,inf",
        "description": "Observatory elevation above sea level (m)"
    },
    {
        "colname": "INSTRUME",
        "mandatory": "y",
        "nullable": false,
        "datatype": "String",
        "description": "Instrument used"
    },
    {
        "colname": "OBSTYPE",
        "mandatory": "y",
        "datatype": "string",
        "allowed_values": "OBJECT,ZERO,FLAT,DARK,FOCUS,COMP",
        "description": "Image type: OBJECT, ZERO, FLAT, DARK, FOCUS"
    },
    {
        "colname": "FILENAME",
        "mandatory": "y",
        "nullable": false,
        "datatype": "String",
        "description": "Original file name"
    },
    {
        "colname": "DATEFILE",
        "mandatory": "n",
        "datatype": "String",
        "description": "File creation date"
    },
    {
        "colname": "DATE-OBS",
        "mandatory": "y",
        "nullable": false,
        "datatype": "String",
        "description": "Exposure start"
    },
    {
        "colname": "UTTIME",
        "mandatory": "n",
        "datatype": "string",
        "description": "UTC time at start of observation"
    },
    {
        "colname": "UTDATE",
        "mandatory": "n",
        "datatype": "Float",
        "description": "UTC at start (s)"
    },
    {
        "colname": "EXPTIME",
        "mandatory": "n",
        "datatype": "Float",
        "description": "Exposure time (s)"
    },
    {
        "colname": "RA",
        "mandatory": "y",
        "datatype": "string",
        "description": "Pointing (deg) (J2000.0)"
    },
    {
        "colname": "DEC",
        "mandatory": "y",
        "datatype": "string",
        "description": "Pointing (deg) (J2000.0)"
    },
    {
        "colname": "EQUINOX",
        "mandatory": "n",
        "nullable": false,
        "datatype": "string",
        "description": "Standard FK5 epoch"
    },
    {
        "colname": "TELFOCUS",
        "mandatory": "n",
        "datatype": "integer",
        "allowed_values": "range:0,inf",
        "description": "Telescope focus position (arbitrary units)"
    },
    {
        "colname": "TCSHA",
        "mandatory": "n",
        "datatype": "string",
        "description": "TCS hour angle: HH:MM:SS"
    },
    {
        "colname": "TCSDATE",
        "mandatory": "n",
        "datatype": "string",
        "description": "TCS local date (isot)"
    },
    {
        "colname": "EXTTEMP",
        "mandatory": "n",
        "datatype": "float",
        "allowed_values": "range:-60,60",
