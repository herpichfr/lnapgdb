    {
        "colname": "AIRMASS",
        "mandatory": "n",
        "datatype": "float",
        "allowed_values": "range:1,inf",
        "description": "Airmass at start of observation"
    },
    {
        "colname": "PRESSURE",
        "mandatory": "n",
        "datatype": "float",
        "allowed_values": "range:0,inf",
        "description": "Barometric pressure (mb), weather tower"
    },
    {
        "colname": "HUMIDITY",
        "mandatory": "n",
        "datatype": "float",
        "allowed_values": "range:0,100",
        "description": "Relative humidity (%), weather tower"
    },
    {
        "colname": "WEIGHT",
        "mandatory": "p",
