        "description": "Value used for NULL pixels"
    },
    {
        "colname": "DATE",
        "mandatory": "y",
        "datatype": "String",
        "description": "Date the file was written"
    },
    {
        "colname": "DATAMAX",
        "mandatory": "n",
        "datatype": "Float",
        "description": "Maximal pixel value"
    },
    {
        "colname": "DATAMIN",
        "mandatory": "n",
        "datatype": "Float",
        "description": "Minimal pixel value"
    },
    {
        "colname": "TEXPTIME",
        "mandatory": "n",
        "datatype": "Float",
        "description": "The arithmetic sum of the integration time of all exposures included in this\nproduct (s)."
    },
    {
        "colname": "MJD-OBS",
        "mandatory": "n",
        "datatype": "Float",
        "description": "MJD at exposure start (d)"
    },
    {
        "colname": "MJD-END",
        "mandatory": "n",
        "datatype": "Float",
        "description": "MJD at exposure end (d)"
    },
    {
        "colname": "DATE-END",
        "mandatory": "n",
        "datatype": "String",
        "description": "Exposure end"
    },
    {
        "colname": "TIMESYS",
        "mandatory": "n",
        "datatype": "String",
        "description": "Time system used"
    },
    {
        "colname": "LST",
        "mandatory": "n",
